  "training_cell": "RESULTS={}\nfor tf in ['M5','M15']:\n    kp.seed_all()\n    model,tokenizer=kp.load_models(WEIGHTS,DEVICE)\n    train_ds=kp.WindowDataset(frames[tf],indices[tf],tf,'train')\n    val_ds=kp.WindowDataset(frames[tf],indices[tf],tf,'validation')\n    checks=kp.contract_tests(model,tokenizer,train_ds,DEVICE)\n    kp.write_json(OUTPUT/f'tests_{tf}.json',checks)\n    result=kp.train(model,tokenizer,train_ds,val_ds,DEVICE,OUTPUT/tf,steps=3,batch_size=1)\n    RESULTS[tf]={'tests':checks,'training':result}\n    print(tf, 'PRUEBA CORTA SUPERADA',json.dumps(result))\n    del model,tokenizer,train_ds,val_ds\n    if DEVICE.type=='cuda': torch.cuda.empty_cache()\n",
